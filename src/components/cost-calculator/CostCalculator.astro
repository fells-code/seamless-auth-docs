---
// The static tables are the no-JavaScript version of the calculator, so they print every
// published price in pricing.ts and nothing the script could not also show.
import {
  type Auth0Plan,
  auth0MauSteps,
  auth0Plans,
  clerk,
  cognito,
  firebase,
  okta,
  type RateTier,
  selfHost,
  selfHostMonthlyUsd,
  sources,
  usd,
  vendorIds,
  vendorNames,
} from './pricing'

const plansFor = (useCase: 'b2c' | 'b2b') => auth0Plans.filter((plan) => plan.useCase === useCase)

type Cell = { text: string; salesUrl?: string }

const cell = (plan: Auth0Plan, mau: number): Cell => {
  const tier = plan.tiers.find((t) => mau <= t.upToMau)
  if (tier) return { text: usd(tier.monthlyUsd) }
  if (plan.aboveTiers === 'unavailable') return { text: 'Not on plan' }
  return { text: 'Contact sales', salesUrl: sources.auth0Sales.url }
}

const steps = [
  ...auth0MauSteps.map((mau) => ({ label: mau.toLocaleString('en-US'), mau })),
  { label: 'Above 30,000', mau: Number.POSITIVE_INFINITY },
]

const rate = (value: number) => (value === 0 ? 'Free' : `$${value}`)

const tierRows = (tiers: RateTier[]) => {
  let floor = 0
  return tiers.map((tier) => {
    const from = (floor + 1).toLocaleString('en-US')
    const to = tier.upTo?.toLocaleString('en-US')
    const label =
      to === undefined
        ? `Above ${floor.toLocaleString('en-US')}`
        : from === to
          ? to
          : `${from} to ${to}`
    floor = tier.upTo ?? floor
    return { label, perUserUsd: tier.perUserUsd }
  })
}

// Bands follow Lite, the plan with the most tiers; every other plan's tiers break on a Lite boundary.
const cognitoBands = tierRows(cognito.plans[0].tiers).map(({ label }, index) => {
  const ceiling = cognito.plans[0].tiers[index].upTo ?? Number.POSITIVE_INFINITY
  return {
    label,
    rates: cognito.plans.map((plan) => {
      const tier = plan.tiers.find((t) => ceiling <= (t.upTo ?? Number.POSITIVE_INFINITY))
      return rate(tier?.perUserUsd ?? 0)
    }),
  }
})

const selfHostSummary = `${usd(selfHostMonthlyUsd)} per month at any MAU (${selfHost.provider} ${usd(
  selfHost.app.monthlyUsd,
)} Droplet plus ${usd(selfHost.database.monthlyUsd)} managed PostgreSQL, checked ${
  selfHost.app.source.checked
})`
---

<div class="cost-calc not-content">
  <form class="cost-calc-form" data-cost-calc hidden>
    <label>
      <span>Compare with</span>
      <select name="vendor">
        <option value="all">All vendors</option>
        {vendorIds.map((id) => <option value={id}>{vendorNames[id]}</option>)}
      </select>
    </label>
    <label>
      <span>Monthly active users</span>
      <input name="mau" type="number" min="1" step="1" value="5000" inputmode="numeric" required />
    </label>
    <fieldset>
      <legend>Use case</legend>
      <label><input type="radio" name="useCase" value="b2c" checked /> B2C</label>
      <label><input type="radio" name="useCase" value="b2b" /> B2B</label>
    </fieldset>
    <label>
      <span>Enterprise connections (SAML, AD/LDAP, and similar)</span>
      <input
        name="enterpriseConnections"
        type="number"
        min="0"
        step="1"
        value="0"
        inputmode="numeric"
      />
    </label>
    <label>
      <span>MFA</span>
      <select name="mfa">
        <option value="none">None</option>
        <option value="otp">Authenticator app (OTP) or Duo</option>
        <option value="enterprise">SMS, voice, email, push, or WebAuthn keys</option>
      </select>
    </label>
  </form>

  <div class="cost-calc-results" data-cost-calc-results aria-live="polite" hidden></div>

  <div data-cost-calc-static>
    <p>
      Auth0 list prices per month, monthly billing, from <a href={sources.auth0.url}
        >auth0.com/pricing</a
      > (checked {sources.auth0.checked}). A MAU count between two steps uses the next step up.
    </p>
    {
      (['b2c', 'b2b'] as const).map((useCase) => (
        <table>
          <caption>Auth0 {useCase === 'b2c' ? 'B2C' : 'B2B'} plans</caption>
          <thead>
            <tr>
              <th scope="col">MAU up to</th>
              {plansFor(useCase).map((plan) => (
                <th scope="col">{plan.name}</th>
              ))}
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            {steps.map(({ label, mau }) => (
              <tr>
                <th scope="row">{label}</th>
                {plansFor(useCase).map((plan) => {
                  const { text, salesUrl } = cell(plan, mau)
                  return <td>{salesUrl ? <a href={salesUrl}>{text}</a> : text}</td>
                })}
                <td>
                  <a href={sources.auth0Sales.url}>Contact sales</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ))
    }
    <p>
      Okta Customer Identity, from <a href={sources.okta.url}>okta.com/pricing</a> (checked {
        sources.okta.checked
      }): the Enterprise base platform starts at {usd(okta.basePlatformFromUsd)} per month, {
        okta.billing
      }, with usage-priced add-ons quoted by sales. The B2C Suite and B2B Suite are <a
        href={sources.oktaSales.url}>contact sales</a
      >.
    </p>
    <p>
      Amazon Cognito price per monthly active user, from <a href={sources.cognito.url}
        >aws.amazon.com/cognito/pricing</a
      > (checked {sources.cognito.checked}, {cognito.region} rates). Each band's rate applies only to
      the users inside it. The free tier is per AWS account or organization. Users who sign in through
      SAML or OIDC are priced separately on every plan: the first {cognito.federated.freeMau}
      free, then {rate(cognito.federated.perMauUsd)} per MAU. SMS and email are billed through Amazon
      SNS and SES.
    </p>
    <table>
      <caption>Amazon Cognito, direct and social sign-in</caption>
      <thead>
        <tr>
          <th scope="col">MAU</th>
          {cognito.plans.map((plan) => <th scope="col">{plan.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          cognitoBands.map(({ label, rates }) => (
            <tr>
              <th scope="row">{label}</th>
              {rates.map((value) => (
                <td>{value}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p>
      Clerk, from <a href={sources.clerk.url}>clerk.com/pricing</a> (checked {
        sources.clerk.checked
      }). Clerk bills monthly retained users (MRU) per application. Hobby is free with a {
        clerk.hobbyMruLimit.toLocaleString('en-US')
      } MRU limit and no MFA or SSO connections. {
        clerk.plans
          .map(
            (plan) =>
              `${plan.name} is ${usd(plan.monthlyUsd)} a month (${usd(plan.annualMonthlyUsd)} billed annually)`,
          )
          .join(' and ')
      }, each with 50,000 MRU and 1 SSO connection included per app and MFA included. SMS is {
        usd(clerk.smsUsCanadaUsd)
      } per SMS in the US and Canada. Enterprise is <a href={sources.clerkSales.url}
        >contact sales</a
      >.
    </p>
    <table>
      <caption>Clerk Pro and Business, usage above the plan price</caption>
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col">Band</th>
          <th scope="col">Price per month</th>
        </tr>
      </thead>
      <tbody>
        {
          tierRows(clerk.mruTiers).map(({ label, perUserUsd }) => (
            <tr>
              <th scope="row">MRU</th>
              <td>{label}</td>
              <td>{perUserUsd === 0 ? 'Included' : `$${perUserUsd} each`}</td>
            </tr>
          ))
        }
        {
          tierRows(clerk.ssoTiers).map(({ label, perUserUsd }) => (
            <tr>
              <th scope="row">SSO connections</th>
              <td>{label}</td>
              <td>{perUserUsd === 0 ? 'Included' : `${usd(perUserUsd)} each`}</td>
            </tr>
          ))
        }
        <tr>
          <th scope="row">SSO connections</th>
          <td>Above {clerk.ssoContactAbove}</td>
          <td><a href={sources.clerkSales.url}>Contact sales</a></td>
        </tr>
      </tbody>
    </table>
    <p>
      Firebase Authentication with Identity Platform, from <a href={sources.firebase.url}
        >firebase.google.com/pricing</a
      > and <a href={sources.identityPlatform.url}>cloud.google.com/identity-platform/pricing</a> (both
      checked {sources.identityPlatform.checked}). Above {
        firebase.sparkMauLimit.toLocaleString('en-US')
      } MAU needs the Blaze plan. SAML and OIDC users: the first {firebase.federated.freeMau} free, then
      {rate(firebase.federated.perMauUsd)} per MAU. Phone sign-in and MFA SMS: {
        usd(firebase.smsUsCanadaUsd)
      } per SMS in the US and Canada, other countries priced per country, first {
        firebase.freeSmsPerDay
      } SMS a day not billed.
    </p>
    <table>
      <caption
        >Firebase Authentication with Identity Platform, email, phone, anonymous, and social users</caption
      >
      <thead>
        <tr>
          <th scope="col">MAU</th>
          <th scope="col">Price per MAU</th>
        </tr>
      </thead>
      <tbody>
        {
          tierRows(firebase.tiers).map(({ label, perUserUsd }) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{rate(perUserUsd)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p>Seamless Auth self-hosted: {selfHostSummary}.</p>
  </div>
</div>

<script>
  import {
    calculate,
    type Inputs,
    isVendorId,
    type Mfa,
    parseQuery,
    type Row,
    usd,
    type UseCase,
  } from './pricing'

  const form = document.querySelector<HTMLFormElement>('[data-cost-calc]')
  const results = document.querySelector<HTMLElement>('[data-cost-calc-results]')

  const priceText = (row: Row): string => {
    switch (row.quote.kind) {
      case 'price':
        return `${usd(row.quote.usd)} / month`
      case 'from':
        return `From ${usd(row.quote.usd)} / month`
      case 'contact':
        return 'Contact sales'
      case 'unavailable':
        return 'Not on this plan'
    }
  }

  const readInputs = (data: FormData): Inputs => {
    const whole = (value: FormDataEntryValue | null, min: number) =>
      Math.max(min, Math.floor(Number(value) || 0))
    const vendor = String(data.get('vendor'))
    return {
      vendor: isVendorId(vendor) ? vendor : 'all',
      mau: whole(data.get('mau'), 1),
      useCase: (data.get('useCase') === 'b2b' ? 'b2b' : 'b2c') as UseCase,
      enterpriseConnections: whole(data.get('enterpriseConnections'), 0),
      mfa: (['none', 'otp', 'enterprise'].includes(String(data.get('mfa')))
        ? data.get('mfa')
        : 'none') as Mfa,
    }
  }

  const render = () => {
    if (!form || !results) return
    const rows = calculate(readInputs(new FormData(form)))
    const table = document.createElement('table')
    table.innerHTML =
      '<caption>Monthly list price for these inputs</caption>' +
      '<thead><tr><th scope="col">Vendor</th><th scope="col">Plan</th>' +
      '<th scope="col">Price</th><th scope="col">Basis</th></tr></thead>'
    const body = document.createElement('tbody')
    for (const row of rows) {
      const tr = document.createElement('tr')
      tr.dataset.kind = row.quote.kind
      const vendor = document.createElement('td')
      vendor.textContent = row.vendor
      const plan = document.createElement('td')
      plan.textContent = row.plan
      const price = document.createElement('td')
      if (row.quote.kind === 'contact' && row.salesUrl) {
        const link = document.createElement('a')
        link.href = row.salesUrl
        link.textContent = priceText(row)
        price.append(link)
      } else {
        price.textContent = priceText(row)
      }
      const notes = document.createElement('td')
      notes.textContent = row.quote.notes.join(' ')
      tr.append(vendor, plan, price, notes)
      body.append(tr)
    }
    table.append(body)
    results.replaceChildren(table)
  }

  const applyQuery = (target: HTMLFormElement) => {
    const query = parseQuery(window.location.search)
    const set = (name: string, value: string | number | undefined) => {
      if (value === undefined) return
      const field = target.elements.namedItem(name)
      if (field instanceof RadioNodeList) field.value = String(value)
      else if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement)
        field.value = String(value)
    }
    set('vendor', query.vendor)
    set('mau', query.mau)
    set('useCase', query.useCase)
    set('enterpriseConnections', query.enterpriseConnections)
    set('mfa', query.mfa)
  }

  if (form && results) {
    applyQuery(form)
    form.hidden = false
    results.hidden = false
    form.addEventListener('input', render)
    form.addEventListener('submit', (event) => event.preventDefault())
    render()
  }
</script>

<style>
  .cost-calc {
    margin-block: 1.5rem;
  }
  .cost-calc-form {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }
  .cost-calc-form[hidden],
  .cost-calc-results[hidden] {
    display: none;
  }
  .cost-calc-form label,
  .cost-calc-form fieldset {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .cost-calc-form fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .cost-calc-form fieldset label {
    flex-direction: row;
    align-items: center;
    gap: 0.4rem;
  }
  .cost-calc-form input[type='number'],
  .cost-calc-form select {
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }
  .cost-calc :global(table) {
    width: 100%;
    margin-block: 1rem;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  .cost-calc :global(caption) {
    text-align: start;
    font-weight: 600;
    color: var(--sl-color-white);
    padding-block-end: 0.5rem;
  }
  .cost-calc :global(th),
  .cost-calc :global(td) {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    text-align: start;
    vertical-align: top;
  }
  .cost-calc :global(a) {
    color: var(--sl-color-text-accent);
  }
  .cost-calc p {
    font-size: var(--sl-text-sm);
    margin-block: 0.75rem;
  }
  .cost-calc :global([data-kind='unavailable']) td:nth-child(3) {
    color: var(--sl-color-gray-3);
  }
  .cost-calc-results :global(tr:last-child td) {
    font-weight: 600;
  }
  .cost-calc-results {
    overflow-x: auto;
  }
  [data-cost-calc-static] {
    overflow-x: auto;
  }
</style>
